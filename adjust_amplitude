def mean_peak2peak(signal):
    """计算信号每周期的平均波峰-波谷幅值"""
    signal = np.array(signal).flatten()
    peaks, _ = find_peaks(signal)
    troughs, _ = find_peaks(-signal)
    extrema = np.sort(np.concatenate([peaks, troughs]))
    if len(extrema) < 2:
        return np.nan
    diffs = np.abs(signal[extrema[1:]] - signal[extrema[:-1]])
    return np.mean(diffs) if len(diffs) > 0 else np.nan


def evaluate_peak2peak(true_signals, pred_signals):
    """对所有样本计算平均波峰-波谷幅值及误差"""
    true_p2p = [mean_peak2peak(s) for s in true_signals]
    pred_p2p = [mean_peak2peak(s) for s in pred_signals]
    valid = [(t, p) for t, p in zip(true_p2p, pred_p2p) if not np.isnan(t) and not np.isnan(p)]
    if not valid:
        return {'True_P2P': np.nan, 'Pred_P2P': np.nan, 'AbsError': np.nan, 'RelError(%)': np.nan}
    t_arr, p_arr = np.array([v[0] for v in valid]), np.array([v[1] for v in valid])
    abs_err = np.mean(np.abs(t_arr - p_arr))
    rel_err = np.mean(np.abs(t_arr - p_arr) / (t_arr + 1e-8)) * 100
    return {
        'True_P2P': np.mean(t_arr),
        'Pred_P2P': np.mean(p_arr),
        'AbsError': abs_err,
        'RelError(%)': rel_err
    }


def main_wave_amplitudes_strict(signal, fs=100, min_cycle_sec=0.6, prominence=0.5, min_amp=50):
    """
    更严格的主波幅度识别：只统计“谷-峰”对，且幅度小于min_amp的不计入
    """
    signal = np.array(signal).flatten()
    min_distance = int(fs * min_cycle_sec)
    peaks, _ = find_peaks(signal, distance=min_distance, prominence=prominence)
    troughs, _ = find_peaks(-signal, distance=min_distance, prominence=prominence)
    extrema = np.concatenate([peaks, troughs])
    extrema.sort()
    amps = []
    peak_idx = []
    trough_idx = []
    i = 0
    while i < len(extrema) - 1:
        if extrema[i] in troughs and extrema[i+1] in peaks:
            tr = extrema[i]
            pk = extrema[i+1]
            amp = signal[pk] - signal[tr]
            if amp >= min_amp:
                amps.append(amp)
                peak_idx.append(pk)
                trough_idx.append(tr)
            i += 2
        else:
            i += 1
    return amps, peak_idx, trough_idx


def evaluate_main_wave_amplitude(true_signals, pred_signals, fs=100, min_cycle_sec=0.6, prominence=0.5, min_amp=50):
    """
    评估每个样本所有周期主波幅度的均值和中位数，并统计误差（严格谷-峰配对，幅度小于min_amp不计入）
    新增：MAPE（平均绝对百分比误差）
    """
    true_amps = [main_wave_amplitudes_strict(s, fs, min_cycle_sec, prominence, min_amp)[0] for s in true_signals]
    pred_amps = [main_wave_amplitudes_strict(s, fs, min_cycle_sec, prominence, min_amp)[0] for s in pred_signals]
    valid = [(np.mean(t), np.mean(p), np.median(t), np.median(p), t, p) for t, p in zip(true_amps, pred_amps) if len(t) > 0 and len(p) > 0]
    if not valid:
        return {'True_Mean': np.nan, 'Pred_Mean': np.nan, 'AbsError_Mean': np.nan, 'RelError_Mean(%)': np.nan,
                'True_Median': np.nan, 'Pred_Median': np.nan, 'AbsError_Median': np.nan, 'RelError_Median(%)': np.nan,
                'MAPE': np.nan}
    t_mean, p_mean, t_median, p_median, t_list, p_list = zip(*valid)
    abs_err_mean = np.mean(np.abs(np.array(t_mean) - np.array(p_mean)))
    rel_err_mean = np.mean(np.abs(np.array(t_mean) - np.array(p_mean)) / (np.array(t_mean) + 1e-8)) * 100
    abs_err_median = np.mean(np.abs(np.array(t_median) - np.array(p_median)))
    rel_err_median = np.mean(np.abs(np.array(t_median) - np.array(p_median)) / (np.array(t_median) + 1e-8)) * 100
    # 计算MAPE（所有周期主波幅度的MAPE，逐元素）
    mape_list = []
    for t, p in zip(t_list, p_list):
        min_len = min(len(t), len(p))
        if min_len == 0:
            continue
        t_arr = np.array(t[:min_len])
        p_arr = np.array(p[:min_len])
        mape = np.mean(np.abs(p_arr - t_arr) / (np.abs(t_arr) + 1e-8)) * 100
        mape_list.append(mape)
    mape_val = np.mean(mape_list) if mape_list else np.nan
    return {
        'True_Mean': np.mean(t_mean),
        'Pred_Mean': np.mean(p_mean),
        'AbsError_Mean': abs_err_mean,
        'RelError_Mean(%)': rel_err_mean,
        'True_Median': np.mean(t_median),
        'Pred_Median': np.mean(p_median),
        'AbsError_Median': abs_err_median,
        'RelError_Median(%)': rel_err_median,
        'MAPE': mape_val
    }


def plot_main_wave(signal, fs=100, min_cycle_sec=0.6, prominence=0.5, min_amp=50, title="主波检测"):
    """画出信号及检测到的主波峰谷（严格谷-峰配对，幅度小于min_amp不画），便于人工核查"""
    import matplotlib.pyplot as plt
    signal = np.array(signal).flatten()
    amps, peaks, troughs = main_wave_amplitudes_strict(signal, fs, min_cycle_sec, prominence, min_amp)
    t = np.arange(len(signal)) / fs
    plt.figure(figsize=(12, 4))
    plt.plot(t, signal, label='信号')
    plt.scatter(t[peaks], signal[peaks], color='r', marker='^', label='主波峰')
    plt.scatter(t[troughs], signal[troughs], color='g', marker='v', label='主波谷')
    for pk, tr in zip(peaks, troughs):
        plt.plot([t[tr], t[pk]], [signal[tr], signal[pk]], 'k--', alpha=0.5)
    plt.xlabel('时间 (秒)')
    plt.ylabel('幅度')
    plt.title(title)
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.show()


