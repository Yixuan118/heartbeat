import numpy as np
from scipy import signal
from scipy.fft import fft, ifft, fftfreq
from scipy.stats import pearsonr
import matplotlib.pyplot as plt
from PyEMD import EEMD

# --- Matplotlib Font Configuration ---
try:
    plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'FangSong', 'Arial Unicode MS']
    plt.rcParams['axes.unicode_minus'] = False
except Exception:
    print("Warning: Failed to set Chinese fonts. Default fonts will be used.")

# =============================================================================
# 1. Configuration
# =============================================================================
fs = 100  # Sampling frequency (Hz)
FFT_DENOISE_THRESHOLD_RATIO = 0.35  # Threshold ratio for FFT denoising
TEST_SEGMENT_NUM = 20  # Number of segments for testing
NOISE_AMOUNT = 0.03  # Gaussian noise intensity after physical attenuation

# Physical attenuation parameters
ATTENUATION_CUTOFF = 8.0  # Frequency cutoff for attenuation (Hz)
ATTENUATION_STRENGTH = 0.5  # Strength of high-frequency attenuation (0~1)

# Path to the real heartbeat signal test set file
new_test_set_file = r"D:\UGA\DataDemo-main\bsg_simulation\data\BSG_train_rr_noise.npy"


# =============================================================================
# 2. Helper Functions
# =============================================================================
def fft_denoise(signal, threshold_ratio):
    """FFT-based frequency domain denoising"""
    fft_result = fft(signal)
    spectrum = np.abs(fft_result)
    threshold = threshold_ratio * np.max(spectrum)
    fft_result[spectrum < threshold] = 0
    denoised_signal = np.real(ifft(fft_result))
    return denoised_signal


def simulate_physical_attenuation(signal, fs, cutoff_freq, attenuation_strength):
    """
    Simulate physical transmission loss (mattress absorption + tissue attenuation)
    High frequencies attenuate more, low frequencies attenuate less
    """
    n = len(signal)
    freqs = fftfreq(n, 1 / fs)  # Get frequency axis
    fft_signal = fft(signal)

    # Design attenuation curve: higher frequency → more attenuation
    # Attenuation factor ranges from 1 (no attenuation) to near 0 (strong attenuation)
    attenuation_factor = np.exp(-attenuation_strength * np.maximum(0, freqs - cutoff_freq))

    # Apply attenuation to both positive and negative frequencies
    fft_attenuated = fft_signal * attenuation_factor

    # Convert back to time domain
    signal_attenuated = np.real(ifft(fft_attenuated))
    return signal_attenuated


def apply_eemd_pipeline(segments, fft_threshold_ratio):
    """Complete EEMD denoising pipeline"""
    processed_segments = []
    eemd = EEMD()
    eemd.trials = 50  # Number of ensemble trials

    for i, seg in enumerate(segments):
        print(f"\rProcessing segment {i + 1}/{len(segments)} with EEMD...", end="")
        seg_centered = seg - np.mean(seg)  # Remove DC component
        IMFs = eemd.eemd(seg_centered)  # EEMD decomposition
        filtered_emd = seg_centered - IMFs[0]  # Remove high-frequency noise (1st IMF)
        denoised_signal = fft_denoise(filtered_emd, threshold_ratio=fft_threshold_ratio)
        processed_segments.append(denoised_signal)

    print("\nEEMD processing completed.")
    return processed_segments


def calculate_metrics(true_segments, pred_segments, method_name):
    """Calculate denoising performance metrics"""
    print(f"\n--- {method_name} ---")
    true_flat = np.concatenate(true_segments)
    pred_flat = np.concatenate(pred_segments)

    min_len = min(len(true_flat), len(pred_flat))
    true_flat, pred_flat = true_flat[:min_len], pred_flat[:min_len]

    # Pearson correlation coefficient
    if np.std(true_flat) == 0 or np.std(pred_flat) == 0:
        corr = np.nan
    else:
        corr, _ = pearsonr(true_flat, pred_flat)

    # Error metrics
    mae = np.mean(np.abs(true_flat - pred_flat))
    mse = np.mean((true_flat - pred_flat) ** 2)
    mean_abs_true = np.mean(np.abs(true_flat))
    amplitude_error = (mae / mean_abs_true if mean_abs_true > 1e-9 else np.inf) * 100

    metrics = {
        "Correlation": corr,
        "MAE": mae,
        "MSE": mse,
        "Amplitude Error (%)": amplitude_error
    }
    for k, v in metrics.items():
        print(f"{k}: {v:.4f}")

    return metrics


# =============================================================================
# 3. Main Execution
# =============================================================================
if __name__ == "__main__":
    print("=" * 70)
    print("EEMD Denoising with Physical Attenuation Simulation")
    print("=" * 70)

    # --- Step 1: Load Data and Generate Physically Attenuated Signals ---
    print("\n[Step 1: Load Data & Simulate Physical Attenuation]")
    try:
        # Load raw heartbeat data
        real_heartbeats_raw = np.load(new_test_set_file)
        print(
            f"Loaded raw data: {real_heartbeats_raw.shape[0]} segments, {real_heartbeats_raw.shape[1]} samples/segment")

        # Prepare ideal segments (ground truth)
        samples_per_segment = 1000
        real_heartbeats_truncated = real_heartbeats_raw[:TEST_SEGMENT_NUM, :samples_per_segment]
        ideal_test_segments = [real_heartbeats_truncated[i, :] for i in range(TEST_SEGMENT_NUM)]
        print(f"Prepared {TEST_SEGMENT_NUM} ideal segments (each {samples_per_segment} samples)")

        # Generate physically attenuated signals (mattress + tissue effects)
        attenuated_segments = []
        for ideal_seg in ideal_test_segments:
            # Apply frequency-dependent physical attenuation
            attenuated_seg = simulate_physical_attenuation(
                signal=ideal_seg,
                fs=fs,
                cutoff_freq=ATTENUATION_CUTOFF,
                attenuation_strength=ATTENUATION_STRENGTH
            )
            attenuated_segments.append(attenuated_seg)

        # Add environmental noise to attenuated signals (real-world scenario)
        noisy_attenuated_segments = []
        for att_seg in attenuated_segments:
            noisy_seg = att_seg + NOISE_AMOUNT * np.random.randn(len(att_seg))
            noisy_attenuated_segments.append(noisy_seg)

        print(f"Generated {len(noisy_attenuated_segments)} physically attenuated + noisy segments")

    except Exception as e:
        print(f"Error in data processing: {str(e)}")
        exit()

    # --- Step 2: Apply EEMD Denoising ---
    print("\n[Step 2: Apply EEMD Denoising]")
    eemd_denoised_segments = apply_eemd_pipeline(
        segments=noisy_attenuated_segments,
        fft_threshold_ratio=FFT_DENOISE_THRESHOLD_RATIO
    )

    # --- Step 3: Evaluate Performance ---
    print("\n[Step 3: Evaluate Denoising Performance]")
    metrics_eemd = calculate_metrics(
        true_segments=ideal_test_segments,
        pred_segments=eemd_denoised_segments,
        method_name="EEMD Denoising on Physically Attenuated Signals"
    )

    # --- Step 4: Visualize Results (Combined Plot) ---
    print("\n[Step 4: Visualize Results]")
    plot_idx = 10  # Segment index to visualize

    if len(ideal_test_segments) > plot_idx and len(noisy_attenuated_segments) > plot_idx and len(
            eemd_denoised_segments) > plot_idx:
        time_axis = np.arange(len(ideal_test_segments[plot_idx])) / fs

        # Create a single figure for plotting all signals together
        plt.figure(figsize=(18, 7))

        # Plot all three signals on the same axes
        plt.plot(time_axis, ideal_test_segments[plot_idx], color='red', linewidth=2.5,
                 label='Original Signal (Ground Truth)')
        plt.plot(time_axis, noisy_attenuated_segments[plot_idx], color='orange', linewidth=1.5, alpha=0.8,
                 label='Attenuated + Noisy Signal')
        plt.plot(time_axis, eemd_denoised_segments[plot_idx], color='green', linewidth=2.5,
                 label=f'EEMD Denoised (Corr: {metrics_eemd["Correlation"]:.3f})')

        # Set title and labels for the combined plot
        plt.title(f'Signal Comparison for Segment #{plot_idx}', fontsize=16)
        plt.xlabel('Time (s)', fontsize=12)
        plt.ylabel('Amplitude', fontsize=12)
        plt.legend(fontsize=11)
        plt.grid(True, which='both', linestyle='--', linewidth=0.5)

        plt.tight_layout()
        plt.show()

    else:
        # Fallback plotting logic in case the index is out of range
        plot_idx_fallback = 0
        time_axis = np.arange(len(ideal_test_segments[plot_idx_fallback])) / fs

        plt.figure(figsize=(18, 7))

        # Plot all three signals on the same axes
        plt.plot(time_axis, ideal_test_segments[plot_idx_fallback], color='red', linewidth=2.5, label='Original Signal')
        plt.plot(time_axis, noisy_attenuated_segments[plot_idx_fallback], color='orange', linewidth=1.5, alpha=0.8,
                 label='Attenuated + Noisy')
        plt.plot(time_axis, eemd_denoised_segments[plot_idx_fallback], color='green', linewidth=2.5,
                 label='EEMD Denoised')

        # Set title and labels for the combined plot
        plt.title(f'Signal Comparison for Segment #{plot_idx_fallback}', fontsize=16)
        plt.xlabel('Time (s)', fontsize=12)
        plt.ylabel('Amplitude', fontsize=12)
        plt.legend(fontsize=11)
        plt.grid(True, which='both', linestyle='--', linewidth=0.5)

        plt.tight_layout()
        plt.show()
        print(f"Warning: Plot index {plot_idx} out of range. Using segment #{plot_idx_fallback}")

    print("\n" + "=" * 70)
    print("Processing Completed")
    print("=" * 70)
