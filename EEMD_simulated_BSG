# =============================================================================
# 2. Helper Functions
# =============================================================================
def fft_denoise(signal, threshold_ratio):
    """
    FFT-based frequency domain denoising: retain frequency components with amplitude above the threshold.
    Args:
        signal: 1D numpy array, time-domain signal to be denoised
        threshold_ratio: float (0~1), ratio of the threshold to the maximum spectrum amplitude
    Returns:
        denoised_signal: 1D numpy array, denoised time-domain signal
    """
    fft_result = fft(signal)
    spectrum = np.abs(fft_result)
    threshold = threshold_ratio * np.max(spectrum)
    fft_result[spectrum < threshold] = 0
    denoised_signal = np.real(ifft(fft_result))
    return denoised_signal


def apply_eemd_pipeline(segments, fft_threshold_ratio):
    """
    Complete EEMD denoising pipeline:
    Signal Centering → EEMD Decomposition → Remove 1st IMF (high-frequency noise) → FFT Denoising
    Args:
        segments: List of numpy arrays, signal segments to be processed
        fft_threshold_ratio: float, threshold ratio for FFT denoising
    Returns:
        processed_segments: List of numpy arrays, EEMD-denoised signal segments
    """
    processed_segments = []
    eemd = EEMD()
    eemd.trials = 50  # Number of ensemble trials for EEMD (balances stability and speed)

    for i, seg in enumerate(segments):
        print(f"\rProcessing segment {i + 1}/{len(segments)} with EEMD...", end="")
        # Step 1: Center the signal (remove DC component)
        seg_centered = seg - np.mean(seg)
        # Step 2: Perform EEMD decomposition
        IMFs = eemd.eemd(seg_centered)
        # Step 3: Remove the 1st IMF (dominated by high-frequency noise)
        filtered_emd = seg_centered - IMFs[0]
        # Step 4: Apply FFT denoising to further reduce residual noise
        denoised_signal = fft_denoise(filtered_emd, threshold_ratio=fft_threshold_ratio)
        processed_segments.append(denoised_signal)

    print("\nEEMD processing completed.")
    return processed_segments


def calculate_metrics(true_segments, pred_segments, method_name):
    """
    Calculate evaluation metrics for denoising performance:
    Correlation Coefficient, MAE, MSE, Amplitude Error (%)
    Args:
        true_segments: List of numpy arrays, ideal noise-free signals (ground truth)
        pred_segments: List of numpy arrays, denoised signals
        method_name: str, name of the denoising method (for log printing)
    Returns:
        metrics: Dictionary, computed evaluation metrics
    """
    print(f"\n--- {method_name} ---")
    # Flatten segment lists into 1D arrays for metric calculation
    true_flat = np.concatenate(true_segments)
    pred_flat = np.concatenate(pred_segments)

    # Ensure equal length of true and predicted signals
    min_len = min(len(true_flat), len(pred_flat))
    true_flat, pred_flat = true_flat[:min_len], pred_flat[:min_len]

    # 1. Pearson Correlation Coefficient (measures linear similarity, 1 = perfect match)
    if np.std(true_flat) == 0 or np.std(pred_flat) == 0:
        corr = np.nan  # Avoid division by zero (meaningless for constant signals)
    else:
        corr, _ = pearsonr(true_flat, pred_flat)

    # 2. Mean Absolute Error (MAE, measures average absolute deviation)
    mae = np.mean(np.abs(true_flat - pred_flat))

    # 3. Mean Squared Error (MSE, penalizes large errors more heavily)
    mse = np.mean((true_flat - pred_flat) ** 2)

    # 4. Amplitude Error (%) (normalized MAE by average absolute amplitude of ground truth)
    mean_abs_true = np.mean(np.abs(true_flat))
    amplitude_error = (mae / mean_abs_true if mean_abs_true > 1e-9 else np.inf) * 100

    # Print metrics
    metrics = {
        "Correlation": corr,
        "MAE": mae,
        "MSE": mse,
        "Amplitude Error (%)": amplitude_error
    }
    for k, v in metrics.items():
        print(f"{k}: {v:.4f}")

    return metrics


