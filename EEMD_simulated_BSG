if __name__ == "__main__":
    print("=" * 70)
    print("EEMD Denoising for Simulated Test Set (Based on Real Heartbeat Data)")
    print("=" * 70)

    # --- Step 1: Load Real Heartbeat Data and Generate Simulated Test Set ---
    print("\n[Step 1: Load Real Heartbeat Data & Generate Simulated Test Set]")
    try:
        # Load raw real heartbeat data (shape: [number_of_segments, samples_per_segment])
        real_heartbeats_raw = np.load(new_test_set_file)
        print(
            f"Successfully loaded real heartbeat data: {real_heartbeats_raw.shape[0]} segments, {real_heartbeats_raw.shape[1]} samples per segment")

        # Extract first TEST_SEGMENT_NUM segments and truncate to fixed length (reduce computation)
        samples_per_segment = 1000  # Fixed length per segment (10s @ 100Hz)
        real_heartbeats_truncated = real_heartbeats_raw[:TEST_SEGMENT_NUM, :samples_per_segment]
        print(
            f"Extracted first {TEST_SEGMENT_NUM} segments (each truncated to {samples_per_segment} samples) for test set")

        # Generate ideal noise-free signals (ground truth for evaluation)
        ideal_test_segments = [real_heartbeats_truncated[i, :] for i in range(TEST_SEGMENT_NUM)]

        # Generate noisy test set (simulate real-world noisy signals for EEMD denoising)
        noisy_test_segments = []
        for ideal_seg in ideal_test_segments:
            noisy_seg = ideal_seg + NOISE_AMOUNT * np.random.randn(len(ideal_seg))
            noisy_test_segments.append(noisy_seg)

        print(
            f"Simulated test set generated: {len(noisy_test_segments)} noisy segments (Gaussian noise intensity: {NOISE_AMOUNT})")

    except Exception as e:
        print(f"Error loading real heartbeat data or generating test set: {str(e)}")
        exit()

    # --- Step 2: Apply EEMD Denoising to the Noisy Test Set ---
    print("\n[Step 2: Apply EEMD Denoising to Noisy Test Set]")
    eemd_denoised_segments = apply_eemd_pipeline(
        segments=noisy_test_segments,
        fft_threshold_ratio=FFT_DENOISE_THRESHOLD_RATIO
    )

    # --- Step 3: Evaluate EEMD Denoising Performance ---
    print("\n[Step 3: Evaluate EEMD Denoising Performance]")
    metrics_eemd = calculate_metrics(
        true_segments=ideal_test_segments,
        pred_segments=eemd_denoised_segments,
        method_name="EEMD Denoising Performance (Simulated Test Set)"
    )

    # --- Step 4: Visualize Denoising Results ---
    print("\n[Step 4: Visualize EEMD Denoising Results]")
    plot_idx = 10  # Index of the segment to visualize (0 ~ TEST_SEGMENT_NUM-1)

    if len(ideal_test_segments) > plot_idx and len(noisy_test_segments) > plot_idx and len(
            eemd_denoised_segments) > plot_idx:
        # Create time axis (unit: seconds)
        time_axis = np.arange(len(ideal_test_segments[plot_idx])) / fs

        # Plot comparison
        plt.figure(figsize=(18, 8))
        # Plot 1: Ideal noise-free signal (ground truth)
        plt.plot(time_axis, ideal_test_segments[plot_idx],
                 label='Original Signal (Ground Truth)',
                 color='red', linewidth=2.5, alpha=0.8)
        # Plot 3: EEMD-denoised signal (output of EEMD)
        plt.plot(time_axis, eemd_denoised_segments[plot_idx],
                 label=f'EEMD Denoised Signal (Corr={metrics_eemd["Correlation"]:.3f})',
                 color='green', linewidth=2, linestyle='-.')

        # Plot settings
        plt.title(f'EEMD Denoising Result Comparison (Test Set Segment #{plot_idx})', fontsize=16)
        plt.xlabel('Time (s)', fontsize=12)
        plt.ylabel('Amplitude', fontsize=12)
        plt.legend(fontsize=11)
        plt.grid(True, alpha=0.5)
        plt.tight_layout()
        plt.show()

    else:
        # Fallback: Visualize the first segment if specified index is out of range
        plot_idx_fallback = 0
        time_axis = np.arange(len(ideal_test_segments[plot_idx_fallback])) / fs

        plt.figure(figsize=(18, 8))
        plt.plot(time_axis, ideal_test_segments[plot_idx_fallback],
                 label='Original Signal (Ground Truth)',
                 color='red', linewidth=2.5, alpha=0.8)
        plt.plot(time_axis, eemd_denoised_segments[plot_idx_fallback],
                 label='EEMD Denoised Signal',
                 color='green', linewidth=2, linestyle='-.')

        plt.title(f'EEMD Denoising Result Comparison (Fallback: Segment #{plot_idx_fallback})', fontsize=16)
        plt.xlabel('Time (s)', fontsize=12)
        plt.ylabel('Amplitude', fontsize=12)
        plt.legend(fontsize=11)
        plt.grid(True, alpha=0.5)
        plt.tight_layout()
        plt.show()
        print(f"Warning: Specified plot index {plot_idx} is out of range. Fallback to segment #{plot_idx_fallback}.")

    print("\n" + "=" * 70)
    print("EEMD Denoising Process Completed")
    print("=" * 70)
