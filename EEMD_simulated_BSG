fs = 100  # Sampling frequency (Hz)
lowcut_freq = 4.5  # Low cutoff frequency for bandpass filter (Hz)
highcut_freq = 9.5  # High cutoff frequency for bandpass filter (Hz)
filter_order = 5  # Order of the bandpass filter
FFT_DENOISE_THRESHOLD_RATIO = 0.35  # Threshold ratio for FFT denoising
TEST_SEGMENT_NUM = 20  # Number of segments to extract for testing (to save computation time)
NOISE_AMOUNT = 0.05  # Noise intensity (Gaussian white noise)

